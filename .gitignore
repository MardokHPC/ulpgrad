# Build directories. Everything CMake generates lives here and nowhere else.
build/
build-*/
_deps/
install/

# Compiled artifacts, including the M0 spike's in-place build.
*.exe
*.obj
*.o
*.pdb
*.ilk
*.lib
*.exp
*.dll

# Generated binary data. ref.bin is 8 MB and reproducible from the documented seed
# and sample manifest, so it never belongs in history.
*.bin

# Spike outputs: regenerated by their run.bat, and their timing fields differ on every run.
# The ULP and parity numbers they carry are quoted, with provenance, in the tracked reports.
experiments/**/report*.json
# Nsight Compute rows written by profile.bat: same reasoning, and they are quoted in the
# report's profiler table with the variant and the metric name next to every number.
experiments/**/stalls.csv

# Python bytecode from the offline tools (mpmath reference generation, fits).
__pycache__/
*.pyc

# CMake files that appear in the source tree when someone configures in-source.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/

# Local planning documents. Kept on disk, never published: they are working notes, not
# part of the repository's documentation.
HANDOFF.md
DEVELOPMENT_PLAN.md
*_QA.md

# Local logs and tool droppings.
*.log
docs/*.log

# IDE / editor.
.vs/
.vscode/
.idea/
*.user
*.suo
*.nuser
